/* PMT v5.2 routing layer — add this AFTER Code_v52_patch.gs in Apps Script. */
function pmtPatchDashboard_(){const c=pmtPatchCache_(),hit=c.get('pmt:v52:Dashboard');if(hit)try{return J(JSON.parse(hit));}catch(e){}const orders=pmtPatchRows_('Orders',pmtPatchOrder_,'pmt:v52:Orders'),repairs=moduleData_('Repairs',x=>({id:String(x[0])})),products=pmtPatchRows_('Products',pmtPatchProduct_,'pmt:v52:Products'),feedback=S('Feedback')?Math.max(0,S('Feedback').getLastRow()-1):0;let revenue=0;orders.forEach(x=>revenue+=Number(x.total||0));const data={ok:true,visitors:0,orders:orders.length,repairs:repairs.length,revenue,feedback,productCount:products.filter(x=>x.status!=='Archived').length,lowStock:products.filter(x=>x.status!=='Archived'&&x.stock<=x.minimum).length,outOfStock:products.filter(x=>x.status!=='Archived'&&x.stock<=0).length,alerts:products.filter(x=>x.status!=='Archived'&&x.stock<=x.minimum).slice(0,10).map(x=>x.name+' is low: '+x.stock+' left')};try{const body=JSON.stringify(data);if(body.length<95000)c.put('pmt:v52:Dashboard',body,PMT_PATCH_CACHE_TTL);}catch(e){}return J(data);}
function pmtPatchCreateOrder_(p){p=p||{};const name=clean_(p.name,80),ph=clean_(p.phone,10),items=Array.isArray(p.items)?p.items:[];if(!name||!phone_(ph)||!items.length)return J({ok:false,message:'Name, valid phone and at least one item are required'});if(!publicRate_('order',ph))return J({ok:false,message:'Please wait before submitting another order.'});const ps=S('Products'),os=S('Orders');if(!ps||!os)return J({ok:false,message:'Service unavailable'});pmtPatchProductColumns_(ps);const rows=ps.getDataRange().getValues(),map={};for(let i=1;i<rows.length;i++){const x=pmtPatchProduct_(rows[i]);if(x.status==='Archived'||x.deletedAt)continue;map[x.id]={row:i+1,p:x};}let total=0,cleanItems=[];for(const it of items){const x=map[String(it.id)],q=Math.max(1,Math.min(99,Number(it.qty)||1));if(!x)return J({ok:false,message:'Product not found: '+clean_(it.id,80)});let price=x.p.price,stock=x.p.stock,variant=null;if(it.variantId&&Array.isArray(x.p.variants)){variant=x.p.variants.find(v=>String(v.id)===String(it.variantId));if(!variant)return J({ok:false,message:'Variant not found'});price=Number(variant.price||price);stock=Number(variant.stock||0);}if(stock<q)return J({ok:false,message:x.p.name+' is out of stock'});total+=price*q;cleanItems.push({id:x.p.id,variantId:variant?String(variant.id):'',variant:variant?variant.name:'',name:x.p.name,qty:q,price});}const id='PMT-ORD-'+new Date().getFullYear()+'-'+Utilities.getUuid().slice(0,8).toUpperCase();os.appendRow([id,now_(),name,ph,JSON.stringify(cleanItems),total,'WhatsApp','Pending']);for(const it of cleanItems){const x=map[it.id];if(it.variantId){const arr=x.p.variants.map(v=>String(v.id)===String(it.variantId)?({...v,stock:Math.max(0,Number(v.stock||0)-it.qty)}):v);ps.getRange(x.row,12).setValue(JSON.stringify(arr));}else ps.getRange(x.row,5).setValue(Math.max(0,x.p.stock-it.qty));ps.getRange(x.row,7).setValue(now_());}upsertCustomer_(name,ph);notification_('order_received','Order '+id+' received',ph);pmtPatchClear_();auditSafe_('order_create',id);return J({ok:true,id,total,discount:0,message:'Order received'});}
function pmtPatchDoGet(e){const a=clean_(e&&e.parameter?e.parameter.action:'',60),p=e&&e.parameter?e.parameter:{};try{if(a==='content')return content_();if(a==='track')return track_(clean_(p.ticket,40));if(a==='publicProducts')return pmtPatchPublicProducts_();if(a==='publicCoupons')return publicCoupons_();const session=auth_(clean_(p.token,160));if(!session)return forbidden_();const minimum={dashboard:'Support',analytics:'Support',homepage:'Editor',products:'Manager',orders:'Support',repairs:'Support',coupons:'Manager',reviews:'Manager',notifications:'Support',lowStock:'Support',users:'Owner',feedback:'Support',activity:'Owner',customers:'Support',inventory:'Support',monthlyReport:'Support',orderDetail:'Support',customerDetail:'Support'}[a];if(minimum&&!roleAllowed_(session,minimum))return forbidden_();if(a==='dashboard')return pmtPatchDashboard_();if(a==='inventory'||a==='lowStock')return pmtPatchInventory_();if(a==='monthlyReport')return pmtPatchMonthlyReport_(p.month);if(a==='orderDetail')return pmtPatchOrderDetail_(clean_(p.id,120));if(a==='customerDetail')return pmtPatchCustomerDetail_(clean_(p.id,120));if(a==='products')return pmtPatchProducts_();if(a==='orders')return pmtPatchOrders_();if(a==='customers')return customers_();if(a==='repairs')return ownerModule_('repairs');if(a==='analytics')return analytics_();if(a==='homepage')return ownerModule_('homepage');if(a==='coupons')return ownerModule_('coupons');if(a==='reviews')return ownerModule_('reviews');if(a==='notifications')return ownerModule_('notifications');if(a==='users')return ownerModule_('users');if(a==='feedback')return feedback_();if(a==='activity')return activity_();return J({ok:true,service:'PMT Owner API',version:'5.2'});}catch(err){auditSafe_('v52_get_error',String(err&&err.message||err));return J({ok:false,message:'Server error'});}}
function pmtPatchDoPost(e){let b={};try{b=JSON.parse((e.postData&&e.postData.contents)||'{}');}catch(err){return J({ok:false,message:'Invalid request'});}const a=clean_(b.action,60);try{if(a==='adminLogin')return login_(clean_(b.username,80),String(b.password||''));if(a==='createRepair')return createRepair_(b.payload||{});if(a==='createFeedback')return createFeedback_(b.payload||{});if(a==='createOrder')return pmtPatchCreateOrder_(b.payload||{});if(a==='analyticsEvent'){analyticsEvent_(b);return J({ok:true});}const session=auth_(b.token);if(!session)return J({ok:false,message:'Unauthorized'});if(a==='logout')return logout_(b.token);if(a==='saveContent')return requireRole_(session,'Editor')?saveContent_(b.content||{},session):forbidden_();if(a==='uploadImage')return requireRole_(session,'Editor')?uploadImage_(b,session):forbidden_();if(a==='createBackup')return requireRole_(session,'Owner')?backupCreate_(session):forbidden_();if(a==='restoreBackup')return requireRole_(session,'Owner')?restoreBackup_(clean_(b.snapshotId,120),session):forbidden_();if(a==='createUser')return requireRole_(session,'Owner')?createUser_(b.payload||{},session):forbidden_();if(a==='updateUser')return requireRole_(session,'Owner')?updateUser_(b.payload||{},session):forbidden_();if(a==='createProduct')return requireRole_(session,'Manager')?pmtPatchCreateProduct_(b.payload||{},session):forbidden_();if(a==='updateProduct')return requireRole_(session,'Manager')?pmtPatchUpdateProduct_(b.payload||{},session):forbidden_();if(a==='deleteProduct')return requireRole_(session,'Manager')?pmtPatchDeleteProduct_(b.payload||{},session):forbidden_();if(a==='restoreProduct')return requireRole_(session,'Manager')?pmtPatchRestoreProduct_(b.payload||{},session):forbidden_();if(a==='createCoupon')return requireRole_(session,'Manager')?createCoupon_(b.payload||{},session):forbidden_();if(a==='updateCoupon')return requireRole_(session,'Manager')?updateCoupon_(b.payload||{},session):forbidden_();if(a==='updateOrder')return requireRole_(session,'Manager')?updateOrder_(b.payload||{},session):forbidden_();if(a==='updateRepair')return requireRole_(session,'Support')?updateRepair_(b.payload||{},session):forbidden_();if(a==='updateReview')return requireRole_(session,'Manager')?updateReview_(b.payload||{},session):forbidden_();return J({ok:false,message:'Unknown action'});}catch(err){auditSafe_('v52_post_error',String(err&&err.message||err));return J({ok:false,message:'Server error'});}}
function doGet(e){return pmtPatchDoGet(e)}
function doPost(e){return pmtPatchDoPost(e)}
