{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piyare-mobile-telecom",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
